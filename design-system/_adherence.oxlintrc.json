{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/data-display/**",
              "components/forms/**",
              "components/icons/**",
              "components/overlay/**",
              "ui_kits/osrs-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Space Grotesk|Roboto|Noto Sans))/i]",
        "message": "Font not provided by the design system. Available: Inter, Space Grotesk, Roboto, Noto Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowCircleDownFill'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<ArrowCircleDownFill> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowCounterClockwise'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<ArrowCounterClockwise> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Backdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Backdrop> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonTemplate'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|icon|style|key|ref|className|style|children)$/]",
        "message": "<ButtonTemplate> doesn't accept that prop. Declared props: state, label, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonTemplate'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|saved)$/]",
        "message": "<ButtonTemplate> state must be one of 'default' | 'saved'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonWithIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:property1|label|icon|style|key|ref|className|style|children)$/]",
        "message": "<ButtonWithIcon> doesn't accept that prop. Declared props: property1, label, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonWithIcon'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|hover)$/]",
        "message": "<ButtonWithIcon> property1 must be one of 'default' | 'hover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaretRight'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<CaretRight> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckCircleFill'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<CheckCircleFill> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoDevRedMasterLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|src|key|ref|className|style|children)$/]",
        "message": "<CoDevRedMasterLogo> doesn't accept that prop. Declared props: height, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoDevSupplyRequestsLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:productName|markHeight|key|ref|className|style|children)$/]",
        "message": "<CoDevSupplyRequestsLogo> doesn't accept that prop. Declared props: productName, markHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoDevWhiteMasterLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|src|key|ref|className|style|children)$/]",
        "message": "<CoDevWhiteMasterLogo> doesn't accept that prop. Declared props: height, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoogleIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<GoogleIcon> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoogleIcon'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:32x32|40x40|48x48)$/]",
        "message": "<GoogleIcon> size must be one of '32x32' | '40x40' | '48x48'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MdiClipboardTextOutline'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<MdiClipboardTextOutline> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='MdiLightClipboardText'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<MdiLightClipboardText> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Search'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Search> doesn't accept that prop. Declared props: placeholder, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignInButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:darkmode|mobile|cta|iconPadding|labelPadding|style|key|ref|className|style|children)$/]",
        "message": "<SignInButton> doesn't accept that prop. Declared props: darkmode, mobile, cta, iconPadding, labelPadding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPills'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|status|availability|label|key|ref|className|style|children)$/]",
        "message": "<StatusPills> doesn't accept that prop. Declared props: shape, status, availability, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPills'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|rounded)$/]",
        "message": "<StatusPills> shape must be one of 'pill' | 'rounded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPills'] > JSXAttribute[name.name='availability'] > Literal[value!=/^(?:available|unavailable)$/]",
        "message": "<StatusPills> availability must be one of 'available' | 'unavailable'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SupplyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|name|availability|availabilityLabel|modelLabel|model|quantity|onQuantityChange|actionLabel|onAction|image|key|ref|className|style|children)$/]",
        "message": "<SupplyCard> doesn't accept that prop. Declared props: category, name, availability, availabilityLabel, modelLabel, model, quantity, onQuantityChange, actionLabel, onAction, image."
      },
      {
        "selector": "JSXOpeningElement[name.name='SupplyCard'] > JSXAttribute[name.name='availability'] > Literal[value!=/^(?:available|unavailable)$/]",
        "message": "<SupplyCard> availability must be one of 'available' | 'unavailable'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
