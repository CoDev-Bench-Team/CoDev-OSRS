# Copy to .env (gitignored). The client id is a public Web OAuth client id, not a
# secret. With VITE_API_BASE_URL unset the SPA stays on the seeded demo and
# never loads Google.

# Session switch. Set to use the published API. Unset keeps the seeded session.
VITE_API_BASE_URL=https://codev-osrs-backend.vercel.app

# Web client from the same Google Cloud project the API verifies (BEN-96).
# http://localhost:5173 must stay an authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=

# Account-picker hint only. The API decides which domains may sign in.
VITE_COMPANY_DOMAIN=codev.com
