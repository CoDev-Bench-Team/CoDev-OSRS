# Copy to .env (gitignored) and fill in. Neither the client id nor the domain is
# a secret — no Google client secret, JWT secret or database credential belongs
# in frontend configuration. With none of these set the SPA runs against the
# seeded demo users and never calls the network.

# Google Web OAuth client id, from the SAME Google Cloud project the backend
# verifies tokens against. Setting it switches the SPA from seeded demo users to
# the published contract. The client must list http://localhost:5173 as an
# authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=

# Google Workspace domain, used as the `hd` account-picker hint. A hint only:
# the API remains responsible for domain validation.
VITE_COMPANY_DOMAIN=codev.com

# Absolute API origin, e.g. https://codev-osrs-backend.vercel.app.
# Leave UNSET in development: the dev server proxies /api to the backend, which
# keeps the API same-origin and the session cookie first-party. Setting it
# requires the backend's CORS allowlist to include this SPA's origin.
VITE_API_URL=
